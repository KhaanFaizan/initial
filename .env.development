# Development environment optimizations
# Disable the ESLint webpack plugin during dev to speed up compilation
DISABLE_ESLINT_PLUGIN=true

# Prevent CRA from automatically opening the browser
BROWSER=none

# Increase Node heap size for large projects (in MB)
NODE_OPTIONS=--max_old_space_size=4096

# Control the delay (in seconds) before the log command runs. Set to 0 to run immediately.
RUN_LOG_DELAY=1

